# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
APP_NAME=T2S Backend
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Placeholder intentionally left blank. Generate a separate value with the command above;
# never reuse JWT_SECRET_KEY.
# Required in production; rate-limited operations fail closed if it is missing.
RATE_LIMIT_KEY_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=t2s-backend
JWT_AUDIENCE=t2s-api
EMAIL_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REFRESH_COOKIE_NAME=t2s_refresh
CSRF_COOKIE_NAME=t2s_csrf
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
FRONTEND_BASE_URL=http://localhost:3000

# Native PostgreSQL on your machine: host=localhost. (Docker Compose later uses host=db.)
DATABASE_URL=postgresql+psycopg://t2s:CHANGE_ME@localhost:5432/t2s
# Tests only. The database name MUST end with _test (tests refuse to run otherwise).
TEST_DATABASE_URL=postgresql+psycopg://t2s:CHANGE_ME@localhost:5432/t2s_test
POSTGRES_USER=t2s
POSTGRES_PASSWORD=
POSTGRES_DB=t2s
# Native development uses localhost; Docker Compose should use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
# Initial administrator bootstrap only. Set true for the one-time CLI, then set false.
ADMIN_BOOTSTRAP_ENABLED=false
# Real-Redis tests only. The pytest fixture reads these from the test process
# environment; placing values only in .env does not configure the fixture.
# Use a dedicated isolated test Redis service; never use REDIS_URL.
# PowerShell from t2s-backend:
# $env:TEST_REDIS_URL = "redis://127.0.0.1:6389/0"
# $env:TEST_REDIS_INTEGRATION = "1"
# python -m pytest -q tests/integration/test_rate_limit_redis.py
# Keep the explicit opt-in; the URL alone must not enable Redis tests.
TEST_REDIS_URL=
TEST_REDIS_INTEGRATION=0

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Shared secret for the AI module (Team Member 3) calling /ai-tools
AI_SERVICE_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@t2s.local
SMTP_STARTTLS=true
SMTP_USE_SSL=false
